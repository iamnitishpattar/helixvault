# HelixVault Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to Git!

# Security & Authentication
# Generate a secure 32-byte hex string (e.g., using python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secure_random_secret_key_here

# Database Configuration
# Defaults to local SQLite (helixvault.db) if unset. For PostgreSQL enterprise deployment, provide standard URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/helixvault_db
DATABASE_URL=

# Steganography & Biochemical Cryptography
# Secret key used for HMAC-SHA256 deterministic marker generation and restriction site avoidance
STEGO_SECRET_KEY=your_stego_secret_key_here

# Rate Limiting Thresholds
RATE_LIMIT_PUBLIC=100/minute
RATE_LIMIT_AUTH=500/minute
AUTH_BACKOFF_BASE_DELAY=2
AUTH_BACKOFF_MAX_ATTEMPTS=3
AUTH_BACKOFF_RESET_WINDOW=3600

# Email Configuration (for OTPs and Password Resets)
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_or_app_password

# NCBI Entrez Integration (for DNA Steganography & Sequence Fetching)
# Get an API key at: https://www.ncbi.nlm.nih.gov/account/
ENTREZ_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here

# Vector RAG & Biosecurity Engine Configuration
# Threshold for semantic vector cosine similarity matches (0.0 to 1.0)
VECTOR_SIMILARITY_THRESHOLD=0.25
RAG_MAX_TOP_K=15
# Set to true to enforce strict biosecurity rejection on moderate homopolymers and restriction sites
BIOSECURITY_STRICT_MODE=false
